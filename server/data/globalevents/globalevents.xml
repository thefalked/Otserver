<?xml version="1.0" encoding="UTF-8"?>
<globalevents>
  <globalevent name="save" interval="1800000" event="script" value="save.lua" />
  <globalevent name="clean" interval="1600000" event="script" value="clean.lua" />
  <globalevent name="texto" interval="1000" script="texto.lua" />
  <globalevent name="lottery" interval="1700000" script="lottery.lua" />
  <globalevent name="serverstart" type="start" event="script" value="start.lua" />
  <globalevent name="globalsave" type="globalsave" event="script" value="init.lua" />
  <globalevent name="playersrecord" type="record" event="script" value="record.lua" />
  <globalevent name="safe_shutdown" interval="5000" event="script" value="restarter.lua" />
  <globalevent name="init" type="startup" event="script" value="init.lua" />
  <globalevent name="house_clean_old" interval="1800000" event="script"
    value="house_clean_old.lua" />

  <!-- Timed events: times are UTC. São Paulo = UTC-3 (no DST).
       zombie 21:00/01:00 UTC = 18:00/22:00 SP
       bug 17:55/22:55 UTC = countdown for 15:00/20:00 SP spawn -->
  <globalevent name="zombie_18" time="21:00" event="script" value="zombie_event.lua" />
  <globalevent name="zombie_22" time="01:00" event="script" value="zombie_event.lua" />
  <globalevent name="event_bug_15" time="17:55" event="script" value="event_bug.lua" />
  <globalevent name="event_bug_20" time="22:55" event="script" value="event_bug.lua" />
</globalevents>
