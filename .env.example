# Copy to `.env` in this directory (gitignored): `cp .env.example .env`
# Required: compose uses `env_file: .env` and fails if `.env` is missing.
# Keep in sync with home-server/otserver/.env.example (minus Traefik-only notes).

# MySQL (no silent defaults — set real values before first up)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ot
MYSQL_USER=ot
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Hostname/IP advertised to game clients after login (config.lua `ip`).
# Must resolve to this host; login/game listen on host TCP 7171/7172.
# Local: 127.0.0.1 — LAN/home-server: baiakvip9.local.thefalked.dev
OT_IP=127.0.0.1

# Standalone only (home-server publishes the site via Traefik instead)
WEBSITE_PORT=8080

# CN / SAN for the nginx self-signed certificate (also used as https:// host)
SITE_DOMAIN=localhost

# VPS only — scripts/setup-vps.sh sets this to also publish host 80/443:
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml
