# Copy to `.env` in this directory (gitignored): `cp .env.example .env`
# Required: compose uses `env_file: .env` and fails if `.env` is missing.
# Keep in sync with home-server/otserver/.env.example (minus Traefik-only notes).

# MySQL (no silent defaults. set real values before first up)
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=ot
MYSQL_USER=ot
MYSQL_PASSWORD=
MYSQL_HOST=mysql
MYSQL_PORT=3306

# Hostname/IP advertised to game clients after login (config.lua `ip`).
# Must resolve to this host; login/game listen on host TCP 7171/7172.
# Local: 127.0.0.1. VPS: same as SITE_DOMAIN (setup-vps.sh / set-domain.sh)
OT_IP=127.0.0.1

# Standalone only (home-server publishes the site via Traefik instead)
WEBSITE_PORT=8080

# Nginx / Let's Encrypt primary hostname. Local: localhost.
# VPS default (scripts/setup-vps.sh, change anytime with scripts/set-domain.sh):
# SITE_DOMAIN=baiakvip9.servegame.com
SITE_DOMAIN=localhost

# Maintenance / Dockhand hostname. **separate** Let's Encrypt cert (not a SAN
# on SITE_DOMAIN). Keeps CT logs from linking public + ops domains.
# SITE_MAINTENANCE_DOMAIN=baiakvip9.thefalked.dev

# Account email for scripts/setup-letsencrypt.sh (expiry mail from Let's Encrypt)
LETSENCRYPT_EMAIL=

# VPS only. Hawser reads TOKEN from /etc/hawser/config (same file as the
# upstream bash/systemd install). Optional display name override:
# HAWSER_AGENT_NAME=otserver-vps

# VPS only. Beszel agent (docker-compose.vps.yml). KEY/TOKEN from the hub UI.
# Hub connects to this host on BESZEL_LISTEN (UFW allows 45876/tcp).
BESZEL_LISTEN=45876
BESZEL_KEY=
BESZEL_TOKEN=
BESZEL_HUB_URL=https://beszel.thefalked.dev

# VPS only. scripts/setup-vps.sh sets this to also publish host 80/443:
# COMPOSE_FILE=docker-compose.yml:docker-compose.vps.yml

# Optional. scripts/backup-mysql.sh uploads the dump to Cloudflare R2 when all
# four required keys are set (S3 API token from R2 → Manage R2 API Tokens).
# Endpoint is https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (no bucket path).
# R2_ACCOUNT_ID=
# R2_BUCKET=otserver-backup
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_PREFIX=mysql/
# Optional docker fallback image if host aws cannot be installed
# (default amazon/aws-cli:latest):
# AWS_CLI_IMAGE=amazon/aws-cli:latest
